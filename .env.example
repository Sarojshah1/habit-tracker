# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/habittrack?retryWrites=true&w=majority

# Authentication Secret (JWT signing token - min 32 chars)
AUTH_SECRET=habittrack-super-secret-jwt-key-for-student-productivity-app-2026

# App URL (Local or Production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Gemini AI API Key (Free from https://aistudio.google.com/)
# Used for AI Study Coach debriefs & AI Flashcard Deck generation.
# If omitted, HabitTrack automatically uses the built-in offline NLP engine with zero external dependencies.
GEMINI_API_KEY=

# Optional: Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
